# ============================================
# BROTHERS GYM - Environment Variables
# ============================================
# Copy this file to .env and fill in real values
# NEVER commit .env to Git

# ---------- Database (Required) ----------
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------- Owner Login (Required) ----------
# ADMIN_EMAIL is the super-admin: the one account that sees ALL branches and can
# switch between them, because it has no branch assigned.
#
# FOOT-GUN: that is decided by the admin_users row, not by this variable. If you
# ever give THIS email's row a branch_id (e.g. by assigning it a branch in the
# admin panel), the super-admin becomes branch-scoped like anyone else and the
# all-branches view disappears — including the branch switcher used to get it
# back. Fix by clearing branch_id on that row, or set BRANCH_SCOPED_OWNERS=false
# temporarily. Give each gym owner their OWN admin account; don't reuse this one.
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=change_to_a_very_strong_password
OWNER_EMAIL=owner_personal@gmail.com

# ---------- Hidden login paths (Recommended) ----------
# The secret URLs that open the login forms. Keeping the real values only in
# .env (never committed) keeps the admin entrance out of the public repo.
#   OWNER_LOGIN_PATH → the owner login (password + email OTP)
#   STAFF_LOGIN_PATH → the staff login (password only)
# Pick long, unguessable values (letters/digits/dashes, no leading slash), e.g.
#   OWNER_LOGIN_PATH=owner-vault-3f9a2c
#   STAFF_LOGIN_PATH=staff-panel-b71e04
# Then visit https://yourdomain.com/<the-value> to log in, and bookmark it.
# If left BLANK, the app falls back to the plain /owner-login and /login routes
# (fine for local dev; set real values in production). This is obscurity, not
# the security boundary — password + OTP + captcha + rate limiting still apply.
OWNER_LOGIN_PATH=
STAFF_LOGIN_PATH=

# ---------- Session signing (Required) ----------
# Signs the admin session cookie so it cannot be forged. Use a long random value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates all existing sessions (everyone is logged out).
SESSION_SECRET=generate_a_long_random_secret

# ---------- Payment Mode (Optional) ----------
# There are exactly TWO values. The old "manual" mode (UPI QR + screenshot upload
# + owner verifies) has been deleted, not parked — if you have PAYMENT_MODE=manual
# left in an env file it now means "razorpay", and env-check says so at boot.
#
#   razorpay  (default, and what unset means) → Razorpay checkout takes the money
#             and the membership activates itself. A member whose branch has no
#             keys configured, or whose checkout fails to load, is shown the
#             contact-the-owner screen instead and lands in the owner's follow-up
#             queue. So this is safe to leave on before KYC is approved.
#   contact   → site-wide kill switch. No gateway is attempted for anyone, no
#             Razorpay script or CSP host ships, and EVERY join becomes a lead the
#             owner calls back. No online payment is taken at all.
#
# Anything unrecognised is treated as "razorpay" on purpose: failing safe here
# means "payments still work", because the opposite failure is a site that quietly
# stops taking money and nobody notices.
#
# NOTE: this is read at BUILD time (next.config.ts splices the Razorpay CSP
# hosts), so changing it needs a REDEPLOY, not just an env-var edit.
PAYMENT_MODE=razorpay

# ---------- Dashboard scoping (Optional) ----------
# Each branch has its own owner, and by default each one sees and edits ONLY their
# own branch: members, plans, staff, attendance, payments, enquiries and join
# requests are all filtered to the branch on their admin user row, and a write
# aimed at the other branch's data is rejected.
#
#   BRANCH_SCOPED_OWNERS=false  → the whole-feature undo. Every owner gets the
#                                 all-branches view again, exactly as before this
#                                 was introduced. Read per REQUEST, not at build
#                                 or module load, so it takes effect immediately
#                                 with no redeploy and no re-login.
# Unset, or any other value, means scoping is ON.
BRANCH_SCOPED_OWNERS=

# There is also a per-owner undo that needs no env change at all: clear the
# branch_id on that owner's row in admin_users and they become a super-admin with
# the all-branches view. That is what makes ADMIN_EMAIL special — see below.

# The homepage testimonials are ONE shared pool for ONE shared website, so they
# cannot be split per gym. This names the branch whose owner curates them; the
# other branch's owner gets a read-only view. Defaults to NR if unset.
BRAND_CONTENT_BRANCH_CODE=NR

# ---------- Razorpay Payments (unless PAYMENT_MODE=contact) ----------
# Read whenever the gateway is live, which is the default. A branch with no keys
# set doesn't break — its members get the contact-the-owner screen and become
# leads in the owner's queue — so the site can go up before KYC clears.
# The Key ID is PUBLIC by
# design — checkout.js runs in the browser and needs it. It only identifies
# which account receives the money. The SECRET is what must never be exposed;
# it must never carry a NEXT_PUBLIC_ prefix.
# Use rzp_test_* while testing; swap to rzp_live_* only after KYC is approved.
#
# ===== TWO ACCOUNTS, ONE PER BRANCH =====
# The two branches have different owners, so payments must settle into different
# bank accounts. That means TWO Razorpay merchant accounts, each with its own
# KYC (each owner's own PAN and bank proof), its own key pair, and its own
# webhook secret. Credentials are suffixed with the branch `code` column:
#
#   NR = Nangal Raya (Shubhrant Thakur)
#   SP = Sagar Pur   (owner has CHANGED — the account, its KYC and its bank
#                     details must all be in the CURRENT owner's name. Money paid
#                     into a previous owner's account cannot be redirected after
#                     the fact; it can only be refunded.)
#
# IMPORTANT: the moment ANY suffixed key below is set, the unsuffixed
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET stop being used as a fallback, and every
# branch must name its own credentials. This is deliberate — a fallback would
# mean forgetting one branch silently charges its members into the OTHER owner's
# account, which nobody notices until a bank statement is reconciled.
RAZORPAY_KEY_ID_NR=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET_NR=xxxxxxxxxxxxxxxxxxxx

RAZORPAY_KEY_ID_SP=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET_SP=xxxxxxxxxxxxxxxxxxxx

# Single-account fallback. Used ONLY when no RAZORPAY_KEY_ID_<CODE> is set above
# — leave these blank in the two-owner setup. NEXT_PUBLIC_RAZORPAY_KEY_ID is no
# longer read at all: the checkout key is returned per-branch by the
# create-order server action, so the browser gets whichever account matches the
# branch the member picked.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secrets — NOT the same as RAZORPAY_KEY_SECRET, and one per
# account. Each is a value YOU choose, then paste into THAT owner's Razorpay
# dashboard under Settings → Webhooks, against its own branch-scoped URL:
#
#   NR account → https://<your-domain>/api/webhooks/razorpay/NR
#   SP account → https://<your-domain>/api/webhooks/razorpay/SP
#   Event      → payment.captured   (NOT payment.authorized — authorised money
#                                    has not actually been captured yet)
#
# This is what proves a "payment captured" message really came from Razorpay. If
# a branch's secret is unset, that branch's webhook refuses every request with a
# 503 rather than trusting the caller — so until it is set, a member who closes
# the tab right after paying will not get their membership created automatically.
#
# The route additionally rejects a delivery whose order belongs to a DIFFERENT
# branch than the URL names, so one owner cannot mint memberships at the other's
# gym with their own (legitimately known) webhook secret.
#
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAZORPAY_WEBHOOK_SECRET_NR=
RAZORPAY_WEBHOOK_SECRET_SP=

# Single-account fallback, same rule as the keys above. Leave blank when using
# per-branch secrets.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email Service - Resend (Required for OTP) ----------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The address emails are sent from. onboarding@resend.dev is Resend's shared
# sender and can ONLY deliver to the email that owns the Resend account —
# everyone else gets a 403. To send to real members, verify your domain at
# resend.com/domains and set this to something like noreply@brothersgym.in
FROM_EMAIL=onboarding@resend.dev

# The name shown in the recipient's inbox ("Brothers Gym" instead of the raw
# address). Defaults to "Brothers Gym" if unset.
FROM_NAME=Brothers Gym

# ---------- Cloudflare Turnstile (Required for login/reset captcha) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_xxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAA_xxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- SMS Service - MSG91 (Optional) ----------
# SMS sending needs BOTH of these. If either is blank the SMS button returns
# "MSG91 not configured" and nothing else in the app breaks.
# MSG91_TEMPLATE_ID is the Flow/template ID from your MSG91 dashboard — MSG91
# rejects free-form SMS in India, so the message body must come from an
# approved template.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Set at signup on the MSG91 dashboard, not read by this app. Kept here only
# as a note of what was registered.
MSG91_SENDER_ID=BRTGYM

# ---------- WhatsApp links (Optional) ----------
# Prefixed onto member phone numbers when building wa.me links.
# 91 = India. Defaults to 91 if unset, so you can leave this out entirely.
NEXT_PUBLIC_WHATSAPP_COUNTRY_CODE=91

# ---------- SEO (Optional) ----------
# Paste the content value of the meta tag Google Search Console gives you.
# Leave blank and no verification tag is emitted at all.
GOOGLE_SITE_VERIFICATION=

# ---------- Error monitoring - Sentry (Optional but strongly recommended) ----------
# Without these, a crash or a failed payment only reaches console.error, which on
# Netlify means a rolling log nobody reads. With them you get an email the moment
# something breaks, plus the stack trace and how many members it hit.
#
# NEXT_PUBLIC_SENTRY_DSN is the only one needed to START RECEIVING errors. It is
# public by design (it ships in the browser bundle) — it can only write events
# into your project, never read them. Get it from:
#   Sentry → Settings → Projects → [project] → Client Keys (DSN)
# Leave it blank and Sentry is fully off: no init, no network calls, no bundle
# cost. That is the normal state for local development.
NEXT_PUBLIC_SENTRY_DSN=

# The rest are BUILD-time only, and only affect whether stack traces are
# readable. Without them the app still reports errors — the traces just point at
# minified code (`main-a3f9.js:1:82910`) instead of real files and line numbers.
# SENTRY_AUTH_TOKEN is a SECRET: it can write to your Sentry org. Never commit it.
#   Sentry → Settings → Account → Auth Tokens (scope: project:releases)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------- Environment ----------
NODE_ENV=
