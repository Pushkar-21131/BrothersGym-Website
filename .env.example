# ============================================
# BROTHERS GYM - Environment Variables
# ============================================
# Copy this file to .env and fill in real values
# NEVER commit .env to Git

# ---------- Database (Required) ----------
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------- Owner Login (Required) ----------
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=change_to_a_very_strong_password
OWNER_EMAIL=owner_personal@gmail.com

# ---------- Hidden login paths (Recommended) ----------
# The secret URLs that open the login forms. Keeping the real values only in
# .env (never committed) keeps the admin entrance out of the public repo.
#   OWNER_LOGIN_PATH → the owner login (password + email OTP)
#   STAFF_LOGIN_PATH → the staff login (password only)
# Pick long, unguessable values (letters/digits/dashes, no leading slash), e.g.
#   OWNER_LOGIN_PATH=owner-vault-3f9a2c
#   STAFF_LOGIN_PATH=staff-panel-b71e04
# Then visit https://yourdomain.com/<the-value> to log in, and bookmark it.
# If left BLANK, the app falls back to the plain /owner-login and /login routes
# (fine for local dev; set real values in production). This is obscurity, not
# the security boundary — password + OTP + captcha + rate limiting still apply.
OWNER_LOGIN_PATH=
STAFF_LOGIN_PATH=

# ---------- Session signing (Required) ----------
# Signs the admin session cookie so it cannot be forged. Use a long random value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates all existing sessions (everyone is logged out).
SESSION_SECRET=generate_a_long_random_secret

# ---------- Razorpay Payments (Optional - for online join) ----------
# The Key ID is PUBLIC by design — checkout.js runs in the browser and needs it.
# It only identifies which account receives the money. The SECRET is what must
# never be exposed; it must never carry a NEXT_PUBLIC_ prefix.
# Use rzp_test_* while testing; swap to rzp_live_* only after KYC is approved.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Webhook signing secret — NOT the same as RAZORPAY_KEY_SECRET.
# This is a value YOU choose, then paste into the Razorpay dashboard under
# Settings → Webhooks when adding https://<your-domain>/api/webhooks/razorpay
# for the `payment.captured` event.
#
# It is what proves a "payment captured" message really came from Razorpay. If
# it is unset, /api/webhooks/razorpay refuses every request with a 503 rather
# than trusting the caller — so until this is set, a member who closes the tab
# right after paying will not get their membership created automatically.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email Service - Resend (Required for OTP) ----------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The address emails are sent from. onboarding@resend.dev is Resend's shared
# sender and can ONLY deliver to the email that owns the Resend account —
# everyone else gets a 403. To send to real members, verify your domain at
# resend.com/domains and set this to something like noreply@brothersgym.in
FROM_EMAIL=onboarding@resend.dev

# The name shown in the recipient's inbox ("Brothers Gym" instead of the raw
# address). Defaults to "Brothers Gym" if unset.
FROM_NAME=Brothers Gym

# ---------- Cloudflare Turnstile (Required for login/reset captcha) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_xxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAA_xxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- SMS Service - MSG91 (Optional) ----------
# SMS sending needs BOTH of these. If either is blank the SMS button returns
# "MSG91 not configured" and nothing else in the app breaks.
# MSG91_TEMPLATE_ID is the Flow/template ID from your MSG91 dashboard — MSG91
# rejects free-form SMS in India, so the message body must come from an
# approved template.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Set at signup on the MSG91 dashboard, not read by this app. Kept here only
# as a note of what was registered.
MSG91_SENDER_ID=BRTGYM

# ---------- WhatsApp links (Optional) ----------
# Prefixed onto member phone numbers when building wa.me links.
# 91 = India. Defaults to 91 if unset, so you can leave this out entirely.
NEXT_PUBLIC_WHATSAPP_COUNTRY_CODE=91

# ---------- SEO (Optional) ----------
# Paste the content value of the meta tag Google Search Console gives you.
# Leave blank and no verification tag is emitted at all.
GOOGLE_SITE_VERIFICATION=

# ---------- Environment ----------
NODE_ENV=
