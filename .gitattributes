# Normalize all text files to LF in the repository and on checkout, so line
# endings stay consistent across Windows/macOS/Linux and Git stops warning
# about "LF will be replaced by CRLF" on `git add`.
* text=auto eol=lf

# Binary assets — never apply text/line-ending normalization to these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.xlsx  binary

# SVG is XML text — leave it normalized and diffable (not marked binary).
