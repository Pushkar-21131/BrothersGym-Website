{
  "name": "brothers-gym",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "node scripts/verify-import-parse.mjs && node scripts/verify-enquiry-parse.mjs && node scripts/verify-whatsapp-message.mjs && node scripts/verify-member-search.mjs && node scripts/verify-permissions.mjs && node scripts/verify-cycle.mjs && node scripts/verify-renewal.mjs && node scripts/verify-activity-history.mjs && node scripts/verify-dashboard-finance.mjs",
    "audit:check": "npm audit --audit-level=high",
    "audit:full": "npm audit",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.65.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.469.0",
    "next": "16.4.6",
    "pg": "8.20.0",
    "razorpay": "^2.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.20",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "brace-expansion@1": "1.1.22",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@sentry/bundler-plugins": {
      "glob": "14.0.6"
    }
  }
}
